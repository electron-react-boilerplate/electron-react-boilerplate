{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node"],
    "tsBuildInfoFile": ".erb/dll/main.tsbuildinfo",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/main", "src/shared"],
  "exclude": ["**/node_modules", "src/**/__tests__/**", "src/**/*.test.*"]
}
